{
  "name": "pagecraft",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace=@pagecraft/web run dev",
    "dev:api": "npm --workspace=@pagecraft/api run dev",
    "dev:worker": "npm --workspace=@pagecraft/worker run dev",
    "dev:realtime": "npm --workspace=@pagecraft/realtime run dev",
    "dev:explorer": "npm --workspace=@pagecraft/explorer run dev",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npx tsx scripts/verify-monorepo.mjs",
    "test:phase2": "npx tsx scripts/verify-phase2-database.mjs",
    "test:all": "npx tsx scripts/verify-monorepo.mjs && npx tsx scripts/verify-phase2-database.mjs"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  }
}
