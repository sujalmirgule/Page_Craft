# ========================================================
# PAGECRAFT PLATFORM — ROOT ENVIRONMENT CONFIGURATION
# Copy to .env for local development. Never commit real credentials.
# ========================================================

NODE_ENV=development

# --- APPLICATION PORTS ---
PORT_WEB=3000
PORT_API=4000
PORT_WORKER=4001
PORT_REALTIME=4002
PORT_EXPLORER=5173

# --- CLIENT PUBLIC URLS ---
VITE_API_URL=http://localhost:4000/api/v1
VITE_REALTIME_WS_URL=ws://localhost:4002
VITE_APP_DOMAIN=pagecraft.app

# --- DATABASE TIER (MONGODB ATLAS & REDIS) ---
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pagecraft?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379

# --- AUTHENTICATION & SECURITY ---
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_signing_secret_here

# --- OAUTH PROVIDERS ---
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback

# --- EXTERNAL SERVICES: MEDIA (CLOUDINARY) ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- EXTERNAL SERVICES: PAYMENTS (RAZORPAY) ---
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# --- EXTERNAL SERVICES: AI (GOOGLE GEMINI) ---
GEMINI_API_KEY=your_google_gemini_api_key

# --- CORS & DOMAINS ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
